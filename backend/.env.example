DJANGO_SETTINGS_MODULE=core.settings.production
ARNOLD_SECRET_KEY=cambie-esta-clave-por-una-de-al-menos-50-caracteres
ARNOLD_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=arnold
POSTGRES_USER=arnold_app
POSTGRES_PASSWORD=cambie-esta-contrasena
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
ARNOLD_FILE_ROOT=/var/lib/arnold/files
# Base64 de 32 bytes aleatorios; no reutilizar ARNOLD_SECRET_KEY.
ARNOLD_DATA_ENCRYPTION_KEY=reemplazar-con-clave-base64-de-32-bytes
ARNOLD_HMAC_KEY=reemplazar-con-otra-clave-secreta-independiente
# El ejecutable recibe la ruta temporal como último argumento y debe devolver 0.
# El Dockerfile actual no instala clamdscan: añada el cliente y el servicio
# antivirus antes de usar esta configuración con información real.
ARNOLD_ANTIVIRUS_COMMAND=clamdscan --no-summary
ARNOLD_MAX_UPLOAD_BYTES=52428800
ARNOLD_XLSX_MAX_ROWS=100000
ARNOLD_XLSX_MAX_COLUMNS=100
ARNOLD_XLSX_MAX_CELLS=2000000
